# Application Configuration
APP_NAME=VaaniFlow AI
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# On cloud hosts like Render, the platform automatically provides the PORT environment variable:
PORT=8000
DEBUG=True

# CORS Configuration (Set your deployed frontend URL on Vercel/Render/Netlify)
# Multiple origins can be comma-separated, or set to * for open development:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
FRONTEND_URL=

# Google Gemini API Credentials (Required for natural-language agent configuration)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs Credentials & Settings (Required for agent creation and live voice sessions)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional fallback voice ID (e.g., 21m00Tcm4TlvDq8ikWAM for Rachel, or SZfY4K69FwXus87eayHK for Indian English):
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Database Configuration
# In local development: data/vaaniflow.db
# On Render with Persistent Disk: /var/data/vaaniflow.db
DATABASE_PATH=data/vaaniflow.db
