# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables & local secrets (CRITICAL: Never commit secrets)
.env
.env.*
*.env
**/.env*
app/.env
!.env.example
!**/.env.example

# Local SQLite databases & data files
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite
data/*.sqlite3

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# IDEs & OS artifacts
.vscode/
.idea/
.DS_Store
Thumbs.db

# Log files
*.log

# Sensitive credentials & certificates
*.pem
*.key
*.cert
